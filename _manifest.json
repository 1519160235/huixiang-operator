{
  "manifest_version": 2,
  "id": "local.huixiang-operator",
  "version": "0.7.0",
  "name": "回响",
  "description": "回响：融合多来源的 MaiBot 运营插件（六块：接入/感知/创作/护栏/发布/状态存储），支持扫码登录、选分区发帖、评论互动、感想总结、后台 Worker 与外围联动；默认演练，不启用不发帖。",
  "author": {
    "name": "回响作者（占位，接入前替换）",
    "url": "https://github.com/1519160235"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/1519160235/huixiang-operator"
  },
  "host_application": {
    "min_version": "1.2.3",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.21.99"
  },
  "dependencies": [
    { "type": "python_package", "name": "httpx", "version_spec": ">=0.28" },
    { "type": "python_package", "name": "qrcode", "version_spec": ">=8" },
    { "type": "python_package", "name": "pillow", "version_spec": ">=9" },
    { "type": "python_package", "name": "pydantic", "version_spec": ">=2.8" }
  ],
  "capabilities": [
    "api.call",
    "llm.generate",
    "send.text",
    "declarative_basic"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "extension"
}
